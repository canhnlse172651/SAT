{
  "project": {
    "name": "SAT",
    "docsLanguage": "vi"
  },
  "paths": {
    "specs": "specs",
    "src": ["apps"],
    "tests": ["tests"],
    "adr": "docs/adr"
  },
  "toolchain": {
    "install": "npm ci",
    "format": "npx --no-install prettier --write --ignore-unknown",
    "lint": "npm run lint",
    "typecheck": "npm run typecheck",
    "test": "npm test --",
    "test:e2e": "npm run test:e2e --",
    "build": "npm run build",
    "start": "npm start",
    "smoke": "node scripts/smoke.mjs",
    "deploy:staging": null,
    "deploy:production": null
  },
  "gates": {
    "humanApproval": {
      "spec": true,
      "production": true
    },
    "requireAnalysis": true,
    "requireTraceability": true,
    "maxFixAttempts": 3
  },
  "git": {
    "branchPrefix": "feat/",
    "baseBranch": "main"
  },
  "pipeline": {
    "claudeBin": "claude",
    "maxTurnsPerPhase": 150,
    "maxBudgetUsdPerPhase": 15,
    "permissionMode": "acceptEdits",
    "model": null
  }
}
