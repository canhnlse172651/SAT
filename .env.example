# Document every configuration variable here with a safe placeholder. Never put real values in this file.
# Local: copy to `.env` (git-ignored) — `npm run dev` / `npm start` load it automatically.
# Staging/production: GitHub environment secrets/vars → the platform's runtime configuration.

# --- API (apps/api/src/config.ts validates these at startup) ---
# development | test | production. `/api/dev/*` exists only in development/test; production refuses to start
# until real email/scheduler adapters exist (ADR-0008).
NODE_ENV=development
PORT=3000
# docker compose up -d mongo
MONGODB_URI=mongodb://127.0.0.1:27017/sat
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Directory of the built SPA served at "/" (set in the Docker image; leave unset in development)
# WEB_DIST_DIR=apps/web/dist

# Public origin of the app. Dev: the Vite origin. Production: the public https URL (required).
APP_ORIGIN=http://localhost:5173
# Idle session lifetime (sliding): teachers in hours, students in days
SESSION_TTL_GV_HOURS=8
SESSION_TTL_HV_DAYS=30
# Cookie `Secure`: always on in production; otherwise follows APP_ORIGIN (https) unless set here
# COOKIE_SECURE=false

# Dev file storage root and max bytes per stored file (default 20 MiB)
# UPLOADS_DIR=var/uploads
# UPLOAD_MAX_BYTES=20971520

# --- Pipeline (only to run the headless agent pipeline locally) ---
# ANTHROPIC_API_KEY=            # or log in once with `claude`

# Dev e-mail outbox: delay of a simulated send in ms (default 1500; addresses on .invalid simulate refusals/bounces).
# DEV_EMAIL_DELAY_MS=1500
