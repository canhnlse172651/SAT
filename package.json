{
  "name": "sat",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run build -w @sat/shared && concurrently -k -n api,web -c blue,magenta \"npm run dev -w @sat/api\" \"npm run dev -w @sat/web\"",
    "db:up": "docker compose up -d --wait mongo",
    "db:down": "docker compose stop mongo",
    "db:logs": "docker compose logs -f mongo",
    "db:shell": "docker compose exec mongo mongosh sat",
    "dev:db": "node scripts/dev-db.mjs",
    "dev:seed": "npm run build -w @sat/shared && npm run build -w @sat/api && npm run seed -w @sat/api",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && npm run build -w @sat/shared && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:harness": "node --test \".sdd/scripts/test/*.test.mjs\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w @sat/api",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild": false,
    "mongodb-memory-server": false
  }
}
